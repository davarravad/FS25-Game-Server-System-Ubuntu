{
  "name": "farmservers-central",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node prepare-assets.mjs",
    "prebuild": "node prepare-assets.mjs",
    "predeploy": "node prepare-assets.mjs",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply farmservers --local",
    "db:remote": "wrangler d1 migrations apply farmservers --remote",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.20.2",
    "miniflare": "^5.20260908.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "dependencies": {
    "entities": "^8.1.0"
  }
}
